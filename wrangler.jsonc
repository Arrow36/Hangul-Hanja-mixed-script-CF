{
  "name": "hangul-hanja-mixed-script-cf",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "hangul-hanja-dictionary", "database_id": "REPLACE_WITH_MAIN_D1_ID", "migrations_dir": "migrations" },
    { "binding": "RAW_DB", "database_name": "hangul-hanja-raw", "database_id": "REPLACE_WITH_RAW_D1_ID", "migrations_dir": "migrations_raw" }
  ]
}
